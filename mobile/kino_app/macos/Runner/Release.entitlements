<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Outgoing connections. Without this the app builds, launches, draws its
	     first screen and reaches nothing: gRPC on :50061 and every poster over
	     http fail inside the sandbox, which looks exactly like a server that is
	     down. `network.server` above is the Flutter tooling's, not ours. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
